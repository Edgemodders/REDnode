{
  "name": "rednode-workspace",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "docs:api": "npm run docs --workspace rednode",
    "docs:game": "node tools/gameapi/build.mjs",
    "docs:examples": "node tools/examples/build.mjs",
    "docs:serve": "node tools/examples/serve.mjs",
    "gameapi:import": "node tools/gameapi/import.mjs",
    "overlay": "npm start --workspace @rednode/overlay",
    "overlay:window": "npm run window --workspace @rednode/overlay",
    "overlay:package": "node tools/overlay/package-host.mjs",
    "release:zip": "node tools/release/player-zip.mjs",
    "release:notes": "node tools/release/notes.mjs",
    "nexus:pull": "node ../EDGErepo/tools/nexus/nexus.mjs pull",
    "nexus:status": "node ../EDGErepo/tools/nexus/nexus.mjs status",
    "release:pack": "node tools/release/pack-zip.mjs",
    "release:redswap": "node tools/release/redswap-zip.mjs",
    "release": "gh workflow run release.yml --ref main -f release=true"
  },
  "devDependencies": {
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "acorn": "8.19.0",
    "codemirror": "6.0.2",
    "esbuild": "0.28.2",
    "highlight.js": "^11.11.1",
    "marked": "18.1.0"
  }
}
